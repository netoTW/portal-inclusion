# Copia este archivo a .env antes de `docker compose up`.
# Valores SOLO para desarrollo local; nada de esto va a producción.

# Postgres 16
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal_dev
POSTGRES_DB=portal
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://portal:portal_dev@db:5432/portal

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO (S3-compatible; StorageAdapter dev)
MINIO_ROOT_USER=portal
MINIO_ROOT_PASSWORD=portal_dev_minio
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=portal-documentos

# API
API_PORT=8000
# Entorno: dev | test | prod
APP_ENV=dev

# Web (Vite)
WEB_PORT=5173
